; 《未名之海》 The Unnamed Sea
; Godot 4.7 project configuration

config_version=5

[application]

config/name="未名之海"
config/description="一款以钓鱼探索和装备成长为核心的第一人称自由实时动作 RPG。当前为近战与钩爪战斗试玩。"
config/version="0.1.0"
run/main_scene="res://scenes/combat_mvp.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
